# Environment: Production
# Description: Environment variables for development environment
# Note: Do not commit sensitive information to version control
VITE_LEARNING_PLATFORM_API_URL="https://lc2025201asi0730sandbox.free.beeceptor.com/api/v1"
VITE_CATEGORIES_ENDPOINT_PATH="/categories"
VITE_TUTORIALS_ENDPOINT_PATH="/tutorials"
VITE_SIGNUP_ENDPOINT_PATH="/authentication/sign-up"
VITE_SIGNIN_ENDPOINT_PATH="/authentication/sign-in"
VITE_USERS_ENDPOINT_PATH="/users"
# VITE_VEHICLES_ENDPOINT_PATH is the path to the vehicles endpoint (BC-04).
VITE_VEHICLES_ENDPOINT_PATH="/vehicles"
# VITE_GEOFENCES_ENDPOINT_PATH is the path to the geofences endpoint (BC-04).
VITE_GEOFENCES_ENDPOINT_PATH="/geofences"
# VITE_TELEMETRY_ENDPOINT_PATH is the path to the telemetry reports endpoint (TS-08).
VITE_TELEMETRY_ENDPOINT_PATH="/telemetry/reports"
# VITE_ORDERS_ENDPOINT_PATH is the path to the orders endpoint (BC-05 Ordering and Dispatch).
VITE_ORDERS_ENDPOINT_PATH="/orders"
# VITE_DISPATCHES_ENDPOINT_PATH is the path to the dispatches endpoint (BC-05 Ordering and Dispatch).
VITE_DISPATCHES_ENDPOINT_PATH="/dispatches"
# VITE_ROUTES_ENDPOINT_PATH is the path to the routes endpoint (BC-06 Transit Traceability).
VITE_ROUTES_ENDPOINT_PATH="/routes"
# VITE_DISCREPANCY_CASES_ENDPOINT_PATH is the path to the discrepancy cases endpoint (Discrepancy and Evidence Management).
VITE_DISCREPANCY_CASES_ENDPOINT_PATH="/discrepancy-cases"
# VITE_PROJECTS_ENDPOINT_PATH is the path to the projects endpoint (Project Management).
VITE_PROJECTS_ENDPOINT_PATH="/projects"
# VITE_MATERIALS_ENDPOINT_PATH is the path to the materials endpoint (Inventory Management).
VITE_MATERIALS_ENDPOINT_PATH="/materials"
# VITE_INVENTORY_MOVEMENTS_ENDPOINT_PATH is the path to the inventory movements endpoint (Inventory Management).
VITE_INVENTORY_MOVEMENTS_ENDPOINT_PATH="/inventory-movements"
# VITE_ACTIVITY_RECORDS_ENDPOINT_PATH is the path to the activity records endpoint (Activity History).
VITE_ACTIVITY_RECORDS_ENDPOINT_PATH="/activity-records"

# VITE_VIGIA_API_URL is an alias of the platform base URL, used by the shared base-api variant of the Transit Traceability bounded context (BC-06). Mirrors VITE_LEARNING_PLATFORM_API_URL.
VITE_VIGIA_API_URL="https://lc2025201asi0730sandbox.free.beeceptor.com/api/v1"
